# Global git ignore — deliberately narrow.
#
# This applies to every repository, including other people's, so it only
# lists things no project ever wants tracked: OS/editor cruft and
# secret-shaped filenames. Anything language-, build-, or data-shaped
# (node_modules/, *.png, Gemfile.lock, dist/, coverage/, ...) belongs in a
# per-project .gitignore or .git/info/exclude instead — a global rule for
# those silently drops files in repos that legitimately track them, with no
# indication anything was skipped.
#
# Linked to $XDG_CONFIG_HOME/git/ignore (git's default location when
# core.excludesFile is unset — see git/gitconfig).

###################################################################
# OS Files
###################################################################

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

###################################################################
# Editor Files
###################################################################

# Vim
*.swp
*.swo
*.swn
.*.sw[a-z]
Session.vim
.netrwhist
tags

# VS Code
.vscode/
*.code-workspace

# JetBrains IDEs
.idea/
*.iml
*.iws
*.ipr
.idea_modules/

###################################################################
# Secret-shaped filenames (safety net)
###################################################################

*.pem
*.key
*.p12
*.pfx
id_rsa
id_dsa
id_ed25519

###################################################################
# Misc
###################################################################

**/.claude/settings.local.json

# Patterns removed from this global file in the 2026 dotfiles review (they
# were too broad for a file applied to every repo — see README/plan): build
# and dependency artifacts (__pycache__/, node_modules/, target/, vendor/,
# dist/, build/, out/, coverage/), package lockfiles (Gemfile.lock,
# composer.lock), env files (.env*), logs and temp files (*.log, tmp/,
# *.bak), database files (*.sqlite, *.db), archives (*.zip, *.tar.gz),
# data/media files (*.png, *.tab, *.xz), man pages (*.[1-9]), and
# project-specific extras (Jupyter, R, Terraform, Docker, LaTeX, Dropbox,
# bioinformatics file extensions).
