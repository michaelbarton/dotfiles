cursor-style = block
font-family = FiraCode Nerd Font
font-size = 16
shell-integration = fish
theme = Catppuccin Frappe
command = /opt/homebrew/bin/fish

# Auto-copy Ghostty terminfo to SSH remote hosts (prevents "unknown terminal" errors)
shell-integration-features = ssh-terminfo

# Desktop notification when a long-running command finishes (only when window isn't focused)
notify-on-command-finish = unfocused

# Let tmux handle all window/tab management
keybind = super+t=unbind
keybind = super+n=unbind
