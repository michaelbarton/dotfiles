#!/bin/bash

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# $HOME/.local/bin must precede Homebrew: `keyring` exists in both, and uv
# needs the uv-tool one (it carries keyrings.codeartifact) for the private
# index. It is the only collision between the two directories.
export PATH="$HOME/.local/bin:$HOME/.bin:/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
export EDITOR=nvim
export VISUAL=nvim

if [ -f "$HOME/.local/environment.bash" ]; then
    source "$HOME/.local/environment.bash"
fi
