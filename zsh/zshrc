#!/bin/zsh

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$HOME/.local/bin:$HOME/.bin:$PATH"
export EDITOR=nvim
export VISUAL=nvim

# Cursor terminal integration
PROMPT_EOL_MARK=""
precmd() { print -Pn "\e]133;D;%?\a" }
preexec() { print -Pn "\e]133;C;\a" }

[ -f "$HOME/.local/environment.bash" ] && source "$HOME/.local/environment.bash"
[ -f "$HOME/.local/environment.zsh" ] && source "$HOME/.local/environment.zsh"
